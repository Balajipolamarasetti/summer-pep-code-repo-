Answer:

4
Why does this work?
BFS explores the grid level by level, and each level corresponds to one minute.

By placing all initially rotten oranges into the queue before starting, they all begin spreading simultaneously.

Every fresh orange is visited exactly once—the first time it becomes rotten—which guarantees that the recorded time is the minimum possible.

If any fresh orange is never visited, it means no rotten orange can reach it, so the answer is -1.

Complexity
Time complexity: O(m × n)

Each cell is processed at most once.

Space complexity: O(m × n)

The queue and visited matrix can each store up to all cells in the worst case.

Code
class Solution {
public:
    int orangesRotting(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();
        vector<vector<int>> vis(m, vector<int>(n, 0));
        int tm = 0;

        queue<pair<pair<int, int>, int>> q;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (grid[i][j] == 2) {
                    q.push({{i, j}, 0});
                    vis[i][j] = 2;
                }
            }
        }

        while (!q.empty()) {
            int r = q.front().first.first;
            int c = q.front().first.second;
            int t = q.front().second;
            q.pop();

            tm = max(tm, t);

            int drow[] = {-1, 0, 1, 0};
            int dcol[] = {0, 1, 0, -1};

            for (int i = 0; i < 4; i++) {
                int nrow = r + drow[i];
                int ncol = c + dcol[i];

                if (nrow >= 0 && nrow < m &&
                    ncol >= 0 && ncol < n &&
                    vis[nrow][ncol] == 0 &&
                    grid[nrow][ncol] == 1) {

                    q.push({{nrow, ncol}, t + 1});
                    vis[nrow][ncol] = 2;
                }
            }
        }

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (grid[i][j] == 1 && vis[i][j] == 0)
                    return -1;
            }
        }

        return tm;
    }
};
